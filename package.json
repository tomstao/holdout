{
  "name": "holdout",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.15.0 <23 || >=24 <25 || >=26 <27",
    "npm": ">=11.6.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "dev": "deepspace dev start",
    "build": "vite build",
    "login": "deepspace auth login",
    "deploy": "deepspace deploy",
    "undeploy": "deepspace app undeploy",
    "add": "deepspace add",
    "test": "deepspace test run",
    "test:smoke": "deepspace test run smoke",
    "test:api": "deepspace test run api",
    "test:e2e": "deepspace test run e2e",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "screenshot": "deepspace test screenshot",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src worker.ts --config .dependency-cruiser.cjs",
    "design:gate": "node scripts/design-gate.ts",
    "validate": "npm run type-check && npm run test:unit",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run arch && npm run design:gate && npm run test:coverage"
  },
  "dependencies": {
    "@base-ui/react": "~1.6.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "ai": "7.0.107",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "deepspace": "0.44.2",
    "hono": "^4.13.7",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "yjs": "^13.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@generouted/react-router": "^1.20.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.14.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.79.0"
  },
  "private": true
}
